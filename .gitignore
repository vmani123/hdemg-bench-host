__pycache__/
*.pyc
.pytest_cache/
.venv/

# host results — the ledger is per-bench-session data, not source
host/results/*.jsonl
host/results/report/
host/results/sim-report/
!host/results/.gitkeep

# ESP-IDF build products
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/sdkconfig.rung
firmware/*/sdkconfig.local
firmware/*/managed_components/
firmware/*/dependencies.lock

# hostrun runtime state
_agent/queue/
_agent/out/
_agent/heartbeat
_agent/audit.log

# overnight.sh logs
host/results/*.log

# STM32CubeIDE build products and per-user state (firmware/stm32h745)
firmware/stm32h745/*/CM*/Debug/
firmware/stm32h745/*/CM*/Release/
firmware/stm32h745/*/CM*/Core/Inc/fw_version.h
firmware/stm32h745/**/.settings/
_agent/cubeide-ws/
_agent/stage2.ready
