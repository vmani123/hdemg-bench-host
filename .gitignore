firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/sdkconfig.rung
firmware/*/sdkconfig.local
firmware/*/managed_components/
firmware/*/dependencies.lock

# hostrun runtime state
_agent/queue/
_agent/out/
_agent/heartbeat
_agent/audit.log
