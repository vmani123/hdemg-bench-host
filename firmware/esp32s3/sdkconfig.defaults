# sdkconfig.defaults — ENVIRONMENT ONLY.
#
# Deliberately carries nothing that affects throughput. Every tuning lever lives in the
# HOST repo's per-chip rung ladders (hdemg-bench-host/rungs/s3/) and is applied at build
# time as a second fragment. That is what stops a lever from being applied to one chip
# and silently forgotten on the other.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_USE_IDLE_HOOK=y
CONFIG_FREERTOS_HZ=1000
