# sdkconfig.defaults — ENVIRONMENT ONLY.
#
# Deliberately carries nothing that affects throughput. Every tuning lever lives in the
# HOST repo's per-chip rung ladders (hdemg-bench-host/rungs/s3/) and is applied at build
# time as a second fragment. That is what stops a lever from being applied to one chip
# and silently forgotten on the other.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# NOT enabled on purpose. This option makes FreeRTOS's idle task call a user-supplied
# vApplicationIdleHook(), which we do not define. Per-core idle accounting goes through
# esp_register_freertos_idle_hook_for_cpu() in instr.c instead — a separate ESP-IDF
# mechanism that needs no Kconfig option, and which is per-core, which is the whole point
# on the dual-core S3.
CONFIG_FREERTOS_HZ=1000
# Rejoin forever. protocol_examples_common stops calling esp_wifi_connect() after this
# many disconnects, so a hotspot blip (or its 90 s idle kick) at 3 a.m. would leave the
# board off the network until someone pressed RESET. Environment, not tuning.
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=1000000
