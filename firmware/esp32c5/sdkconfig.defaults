# sdkconfig.defaults — ENVIRONMENT ONLY.
#
# Deliberately carries nothing that affects throughput. Every tuning lever lives in the
# HOST repo's per-chip rung ladders (hdemg-bench-host/rungs/c5/) and is applied at build
# time as a second fragment.
#
# Not valid on C5 / IDF v6 — do not add: CONFIG_ESP_INTR_IN_IRAM, CONFIG_ESP_PHY_IRAM_OPT.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_USE_IDLE_HOOK=y
CONFIG_FREERTOS_HZ=1000
